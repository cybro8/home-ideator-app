# ── MySQL ──────────────────────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=home_ideator
MYSQL_USER=homeuser
MYSQL_PASSWORD=homepass
MYSQL_ROOT_PASSWORD=rootpass

# ── MongoDB ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017
MONGO_DATABASE=home_ideator

# ── JWT Secrets (change in production!) ────────────────────────────────
ADMIN_JWT_SECRET=admin_super_secret_change_me
USER_JWT_SECRET=user_super_secret_change_me
JWT_ALGORITHM=HS256
ADMIN_TOKEN_EXPIRE_HOURS=8
USER_TOKEN_EXPIRE_HOURS=24

# ── Service ports ───────────────────────────────────────────────────────
IOT_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
ADMIN_SERVICE_PORT=8003

# ── Test databases (used by pytest) ─────────────────────────────────────
TEST_MYSQL_DATABASE=home_ideator_test
TEST_MONGO_DATABASE=home_ideator_test
